FROM mcr.microsoft.com/dotnet/runtime:10.0 AS base
WORKDIR /app
ENV TZ=Asia/Shanghai

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY NuGet.Config ./
COPY ["KubeSpoke.Agent/KubeSpoke.Agent.csproj", "KubeSpoke.Agent/"]
COPY ["KubeSpoke.Contracts/KubeSpoke.Contracts.csproj", "KubeSpoke.Contracts/"]
RUN dotnet restore "KubeSpoke.Agent/KubeSpoke.Agent.csproj"
COPY . .
WORKDIR "/src/KubeSpoke.Agent"
# publish 自带编译，原来这里先 build 再 publish 等于同一份代码编译两遍
RUN dotnet publish "KubeSpoke.Agent.csproj" -c Release -o /app/publish /p:UseAppHost=false --no-restore

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
# Helm 走 PATH 找可执行文件，镜像里自带一份固定版本，避免每台宿主机的 helm 不一致。
# 远程 ADD 不会自动解包，所以先落到 /tmp 再手工取里面的二进制。
ADD https://get.helm.sh/helm-v4.3.1-linux-amd64.tar.gz /tmp/helm.tgz
RUN set -eux; \
    tar -xzf /tmp/helm.tgz -C /tmp; \
    mv /tmp/linux-amd64/helm /usr/local/bin/helm; \
    chmod +x /usr/local/bin/helm; \
    rm -rf /tmp/helm.tgz /tmp/linux-amd64; \
    helm version

ENTRYPOINT ["dotnet", "KubeSpoke.Agent.dll"]
